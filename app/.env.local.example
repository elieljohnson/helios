# Helios local environment — copy to .env.local and fill in.
# .env.local is gitignored; this template is committed.

# Postgres (Neon). Use the "Pooled connection" string from the Neon dashboard.
# Example shape:
#   postgresql://user:pass@ep-xxxxx-pooler.us-west-2.aws.neon.tech/helios?sslmode=require
DATABASE_URL=

# Shared secret for the external cron trigger. Generate locally:
#   openssl rand -hex 32
# The GitHub Actions workflow must have this same value in HELIOS_CRON_TOKEN.
CRON_SECRET=

# --- Integrations (wire up as each phase lands) ---
# Enphase Enlighten v4
ENPHASE_CLIENT_ID=
ENPHASE_CLIENT_SECRET=
ENPHASE_API_KEY=

# Tesla Fleet API
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=

# Rivian via Smartcar (OAuth aggregator). Free dev tier covers
# single-vehicle personal use. Sign up at https://dashboard.smartcar.com
# and create a "Live mode" application; mode=live + scope=read_battery
# read_charge control_charge.
SMARTCAR_CLIENT_ID=
SMARTCAR_CLIENT_SECRET=
SMARTCAR_REDIRECT_URI=https://helios-eeg1.vercel.app/api/auth/smartcar/callback
